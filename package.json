{
  "name": "tiktok-multishop",
  "version": "1.0.0",
  "description": "Quan ly nhieu gian hang TikTok Shop trong 1 app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "local.tiktok.multishop",
    "productName": "186 HOME - TikTok MultiShop",
    "files": [
      "**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "186 HOME - TikTok MultiShop"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png",
      "category": "public.app-category.business"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}